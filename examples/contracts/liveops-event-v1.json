{
  "contract_version": 1,
  "name": "liveops-event-v1",
  "required": {
    "event_id": "string",
    "event_type": "string",
    "user_id": "string",
    "occurred_at": "datetime"
  },
  "optional": {
    "session_id": "string",
    "properties": "object"
  },
  "unique": ["event_id"],
  "allowed_values": {
    "event_type": ["login", "session_start", "purchase", "level_complete"]
  },
  "constraints": [
    {
      "when": {
        "field": "event_type",
        "equals": "purchase"
      },
      "require": ["properties.amount", "properties.currency"],
      "types": {
        "properties.amount": "number",
        "properties.currency": "string"
      },
      "minimum": {
        "properties.amount": 0
      }
    }
  ]
}
